PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_POOLED_HOST/neondb?sslmode=require"
# Use Neon\'s unpooled connection string for Prisma migrations when available.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_DIRECT_HOST/neondb?sslmode=require"
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=15000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=30000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
REDIS_URL=redis://localhost:6379
EVENT_PUBLISH_RETRIES=3
EMAIL_VERIFICATION_TTL_HOURS=168
EMAIL_VERIFICATION_SUSPEND_AFTER_HOURS=72
PASSWORD_RESET_TTL_HOURS=1
AUTH_EXPOSE_EMAIL_TOKENS=false
SUPER_ADMIN_NAME=Ashwa Logix Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAIL_ENABLED=false
RESEND_API_KEY=re_your-api-key
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_REPLY_TO_EMAIL=support@example.com
FRONTEND_BASE_URL=http://localhost:5173
